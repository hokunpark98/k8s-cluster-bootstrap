# Copy this file to cluster.env, fill in the node addresses and credentials,
# then run the bootstrap script on the control plane. cluster.env is ignored by Git.
NODE_ROLE=control-plane

# Exact infrastructure versions.
KUBERNETES_VERSION=1.35.6
CONTAINERD_VERSION=2.2.6
CALICO_VERSION=3.32.1
HELM_VERSION=3.20.0

# All four RTX 3090 backend nodes receive Toolkit/CDI and GPU operands.
INSTALL_NVIDIA_STACK=true
NVIDIA_DRIVER_VERSION=580.173.02
NVIDIA_CONTAINER_TOOLKIT_VERSION=1.19.1
NVIDIA_GPU_MODEL=RTX 3090
NVIDIA_GPU_MEMORY_MIB=24576
NVIDIA_GPU_COUNT_PER_WORKER=1
GPU_OPERATOR_VERSION=26.3.3

# Infrastructure only. No DGD, model, Frontend, EPP, planner, or worker is created.
INSTALL_DYNAMO_PLATFORM=true
DYNAMO_PLATFORM_VERSION=1.3.0
DYNAMO_VLLM_VERSION=0.23.0
DYNAMO_VLLM_IMAGE=nvcr.io/nvidia/ai-dynamo/vllm-runtime:1.3.0
DYNAMO_NAMESPACE=dynamo-system
DYNAMO_NATS_STORAGE_CLASS=prrw-local-nats
DYNAMO_NATS_STORAGE_SIZE=10Gi
DYNAMO_NATS_STORAGE_PATH=/var/lib/prrw/dynamo-nats
PREPULL_DYNAMO_VLLM_IMAGE=true

# Gateway/Inference Extension foundation only. No Gateway instance is created.
INSTALL_GATEWAY_FOUNDATION=true
GATEWAY_API_VERSION=1.5.1
GAIE_VERSION=1.2.1
AGENTGATEWAY_VERSION=1.0.0
AGENTGATEWAY_NAMESPACE=agentgateway-system

# Control-plane and cluster network settings.
CONTROL_PLANE_IP=192.168.0.10
POD_CIDR=10.244.0.0/16
INSTALL_CALICO=true
INSTALL_METRICS_SERVER=true
METRICS_SERVER_VERSION=0.8.1

# Optional: copy admin.conf to this user's home. Leave empty if unnecessary.
REGULAR_USER_HOME=/home/dnclab

# This repository intentionally fixes the research topology to four homogeneous
# RTX 3090 backend workers. Empty values are prompted for.
GPU_WORKER_COUNT=4

GPU_WORKER_1_IP=192.168.0.11
GPU_WORKER_1_SSH_USER=dnclab
GPU_WORKER_1_SSH_PASSWORD=

GPU_WORKER_2_IP=192.168.0.12
GPU_WORKER_2_SSH_USER=dnclab
GPU_WORKER_2_SSH_PASSWORD=

GPU_WORKER_3_IP=192.168.0.13
GPU_WORKER_3_SSH_USER=dnclab
GPU_WORKER_3_SSH_PASSWORD=

GPU_WORKER_4_IP=192.168.0.14
GPU_WORKER_4_SSH_USER=dnclab
GPU_WORKER_4_SSH_PASSWORD=
